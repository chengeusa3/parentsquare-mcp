# Copy the values you need into your MCP client's "env" block (see README).
# This file is a reference — the server reads the environment, not this file.

# ---------------------------------------------------------------- required
# One of the two auth methods below.

# Method 1 (recommended, and the only one that works with SSO):
# the Cookie header copied from a logged-in ParentSquare browser tab.
PARENTSQUARE_COOKIE=_parentsquare_session=abc123...; remember_user_token=xyz...

# Method 2: ParentSquare email + password. Does not work with
# Google/Clever/ClassLink sign-in or two-factor.
PARENTSQUARE_EMAIL=you@example.com
PARENTSQUARE_PASSWORD=your-password

# ---------------------------------------------------------------- optional

# If your district uses a vanity host instead of www.parentsquare.com.
PARENTSQUARE_BASE_URL=https://www.parentsquare.com

# Personal calendar subscription link, from Calendar → Subscribe in ParentSquare.
# The server tries to discover this on its own; set it if discovery fails.
PARENTSQUARE_ICS_URL=

# Where download_file saves things. Default: ~/Downloads/ParentSquare
PARENTSQUARE_DOWNLOAD_DIR=

# Where the cached session lives. Default: ~/.parentsquare-mcp
PARENTSQUARE_STATE_DIR=

# Attachments above this size are linked instead of inlined. Default 4 MB.
PARENTSQUARE_MAX_INLINE_BYTES=4000000

# HTTP timeout in seconds. Default 30.
PARENTSQUARE_TIMEOUT_S=30

# Set to 1 to log request/route diagnostics to stderr.
PARENTSQUARE_DEBUG=0
